  "results": {
    "egyptian": {
      "t01": "عيش طازة كل صبح.",
      "t02": "صباح الخير! جاهز ليوم جديد؟",
      "t03": "إزيك، وحشتني من زمان!",
      "t04": "ولا يهمك، بتحصل عادي.",
      "t05": "يلا نشرب قهوة بعدين.",
      "t06": "خلص كله",
      "t07": "الدخول ببلاش",
      "t08": "مواعيد الفتح",
      "t09": "استنى... إيه اللي حصل؟",
      "t10": "يعني... نفس المعاد بكرة؟",
      "t11": "\"لسه طالع من الفرن!\" قالت.",
      "t12": "سميرة ماسكة المخبز في شارع المعز.",
      "t13": "عمر وليلى جايين يزوروا القاهرة الأسبوع الجاي.",
      "t14": "محل نور جنب محطة إسكندرية.",
      "t15": "يوسف ودينا وكريم طلبوا 3 أرغفة.",
      "t16": "اسأل سلمى على وصفة العيش المخمر.",
      "t17": "حسن ومنى فتحوا كافيه في أسوان.",
      "t18": "طارق ورانيا وفادي وهالة جايين.",
      "t19": "زياد دفع 145 جنيه في التورتة.",
      "t20": "منيو التذوق بـ 1,200 جنيه.",
      "t21": "الرغيف الواحد بـ 6.50، والاتنين بـ 12.00.",
      "t22": "بنفتح 08:30 وبنقفل 19:45.",
      "t23": "سوق الليل بيبدأ 18:00 يوم الجمعة.",
      "t24": "ترابيزة لـ 4 الساعة 20:15، لو سمحت.",
      "t25": "بوم!",
      "t26": "طراخ!",
      "t27": "فششش...",
      "t28": "جرب خلطة مونبرو الجديدة.",
      "t29": "مونبرو بيتحمص على دفعات صغيرة.",
      "t30": "اطلب مونبرو وحتة تورتة.",
      "t31": "أمينة وبلال وفرح وخالد بيتشاركوا المحل أيام السبت.",
      "t32": "الخباز بيصحى قبل الشروق، يسخن الفرن، ويشكل كل رغيف بإيده والمدينة لسه هادية.",
      "t33": "خد بالك إن المطبخ بيقفل قبل المحل بـ 30 دقيقة، وآخر طلبات منيو التذوق بتتاخد الساعة 8.",
      "t34": "سمير ولينا ومريم هيجيبوا العيش السوق الساعة 06:45.",
      "t35": "كافيه نادية بيقدم 3 أنواع شاي و 2 أنواع قهوة.",
      "t36": "رامي وسارة حجزوا ترابيزة لـ 6 الساعة 21:00.",
      "t37": "بوستر السفر بتاع تامر مكتوب عليه جولات الغروب بحروف كبيرة.",
      "t38": "يارا لقت ورقة مكتوبة بالإيد: 'عيش طازة يوميا'.",
      "t39": "التيكت مكتوب عليه عسل الزهور البرية 500g.",
      "t40": "شكرا لدعمكم مخبز محلي صغير!"
    },
    "msa": {
      "t01": "خبز طازج كل صباح.",
      "t02": "صباح الخير! هل أنت مستعد ليوم آخر؟",
      "t03": "مرحبا، مضى وقت طويل منذ أن رأيتك!",
      "t04": "لا تقلق، هذا يحدث.",
      "t05": "لنتناول القهوة لاحقا.",
      "t06": "نفدت الكمية",
      "t07": "الدخول مجاني",
      "t08": "ساعات العمل",
      "t09": "انتظر... ماذا حدث؟",
      "t10": "إذن... نفس الوقت غدا؟",
      "t11": "قالت: طازج من الفرن!",
      "t12": "تدير سميرة المخبز في شارع المعز.",
      "t13": "سيزور عمر وليلى القاهرة الأسبوع المقبل.",
      "t14": "يقع متجر نور بالقرب من محطة الإسكندرية.",
      "t15": "طلب يوسف ودينا وكريم ثلاثة أرغفة.",
      "t16": "اسأل سلمى عن وصفة خبز العجين المخمر.",
      "t17": "افتتح حسن ومنى مقهى في أسوان.",
      "t18": "طارق ورانيا وفادي وهالة قادمون.",
      "t19": "دفع زياد 145 جنيها ثمن الكعكة.",
      "t20": "تتكلف قائمة التذوق 1,200 جنيه.",
      "t21": "الرغيف الواحد بسعر 6.50، والرغيفان بسعر 12.00.",
      "t22": "نفتح في 08:30 ونغلق في 19:45.",
      "t23": "يبدأ السوق الليلي في 18:00 يوم الجمعة.",
      "t24": "طاولة لأربعة أشخاص في 20:15، من فضلك.",
      "t25": "بوم!",
      "t26": "طاخ!",
      "t27": "وششش...",
      "t28": "جرب خلطة مونبرو الجديدة.",
      "t29": "يُحمص مونبرو على دفعات صغيرة.",
      "t30": "اطلب مونبرو وشريحة من الكعك.",
      "t31": "تتشارك أمينة وبلال وفرح وخالد المتجر أيام السبت.",
      "t32": "يستيقظ الخباز قبل شروق الشمس، ويسخن الفرن، ويشكل كل رغيف بيده بينما لا تزال المدينة هادئة.",
      "t33": "يرجى ملاحظة أن المطبخ يغلق قبل المتجر بثلاثين دقيقة، ويتم أخذ آخر طلبات قائمة التذوق في الثامنة.",
      "t34": "سيحضر سمير ولينا ومريم الخبز إلى السوق في 06:45.",
      "t35": "يقدم مقهى نادية 3 أنواع من الشاي ونوعين من القهوة.",
      "t36": "حجز رامي وسارة طاولة لستة أشخاص في 21:00.",
      "t37": "يقول ملصق السفر الخاص بتامر جولات الغروب بحروف كبيرة.",
      "t38": "وجدت يارا ملاحظة مكتوبة بخط اليد: خبز طازج يوميا.",
      "t39": "الملصق يقول عسل الزهور البرية 500غ.",
      "t40": "شكرا لدعمكم مخبزا محليا صغيرا!"
