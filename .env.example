# Copy to .env and fill in. .env is gitignored — never commit a real key.
#
# Create a key at https://dev.meta.ai/platform (Keys tab). It starts with LLM_.
MODEL_API_KEY=

# Meta Model API
META_API_BASE_URL=https://api.meta.ai/v1

# Model IDs (confirmed against https://dev.meta.ai/docs/models)
MUSE_SPARK_MODEL=muse-spark-1.3
MUSE_IMAGE_MODEL=muse-image-1.0
SAM_MODEL=sam-3.1

# Backend
NAQSH_ENV=development
NAQSH_CORS_ORIGINS=http://localhost:5173
