# Secrets — never commit these
.env
.env.*
!.env.example

# Node
node_modules/
dist/
dist-ssr/
.vite/
*.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Scratch space (API docs snapshots, probes, throwaway outputs)
.tmp/
.ecc/tmp/

# Generated API output that should not bloat the repo
backend/.cache/
assets/generated/*.tmp.*

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
